# MPP app (Mon Petit Prono) Auth0 access token (required by MPP Autopilot)
MPP_TOKEN=

# The Odds API key for Ligue 1 market odds (required)
ODDS_API_KEY=

# MPP Autopilot settings
# Submit predictions. false = dry-run (compute and log only)
WRITE=false

# Hour of the daily MPP fetch, Europe/Paris
DAILY_HOUR=7

# Optional
# LOG_LEVEL=INFO
